# Copia este archivo a .env.local y llena los valores desde
# Firebase Console → Configuración del proyecto → Tus apps → Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Servidor (Admin SDK) ---
# En local basta con tener ./service-account.json (ignorado por git).
# En producción (Docker) pasa el JSON completo en una sola variable:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# o la ruta al archivo:
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase.json

# Notificaciones (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
# Token para GET /api/cron/avisos (openssl rand -hex 32)
CRON_SECRET=
DOMUS_ZONA=America/El_Salvador
# Producción: JSON de la cuenta de servicio (ver scripts/netlify-env.mjs)
FIREBASE_SERVICE_ACCOUNT=
